# 环境变量模板
# 复制为 .env 后填写；.env 已在 .gitignore 中，不会进 git。

# ---------- LLM（本地网关，OpenAI 兼容） ----------
# 注意：该网关即使 stream=false 也只返回 SSE，客户端需自行收拢。
LLM_BASE_URL=http://127.0.0.1:3211/api/open-platform-model/v1
LLM_API_KEY=local
LLM_MODEL=deepseek-v4.1-flash

# ---------- Embedding（阿里云百炼，仅北京端点） ----------
# qwen3.7-text-embedding-flash: 1024/768/512/256 维；不支持 intl 端点。
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMS=1024

# ---------- 可选：代理 ----------
# 留空表示直连。访问本地网关时必须把 127.0.0.1 放进 NO_PROXY。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=127.0.0.1,localhost

# ---------- 可选：HuggingFace 镜像 ----------
# HF_ENDPOINT=https://hf-mirror.com
